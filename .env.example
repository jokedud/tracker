# Postgres connection string (Neon via the Vercel Marketplace, Supabase, or any Postgres).
DATABASE_URL=postgres://user:password@host:5432/db?sslmode=require
# Long random string used to sign tracking links. Generate: openssl rand -hex 32
TRACKING_SECRET=change-me
# Password for /dashboard (HTTP Basic auth, any username).
DASHBOARD_PASSWORD=change-me
# Optional: comma-separated hostnames destinations must belong to (subdomains allowed). Empty = any https/http host, as long as the link is signed.
ALLOWED_DEST_HOSTS=
# IP storage: full | truncate (zero last IPv4 octet / last 80 bits of IPv6) | none
IP_MODE=full
# Geo fallback when Vercel geo headers are missing: none | ipwhois (https://ipwho.is, free, no key)
GEO_FALLBACK=ipwhois
# Collect GPU renderer, CPU cores, device memory and battery on the click page: on | off (see README, consent required in many jurisdictions)
DETAILED_FINGERPRINT=on
# Optional: base URL used by the dashboard link builder (defaults to the request host)
PUBLIC_BASE_URL=
